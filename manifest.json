{
    "manifest_version": 3,
    "name": "Globo sem Ruído",
    "description": "Hides noisy sections of globo.com, such as sports",
    "version": "1.0.2",
    "browser_specific_settings": {
        "gecko": {
            "id": "css-override@tiagovignatti",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["https://*.globo.com/*"],
            "css": ["content_script.css"],
            "js": ["content_script.js"],
            "run_at": "document_start"
        }
    ]
}