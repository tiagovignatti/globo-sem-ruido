{
    "manifest_version": 3,
    "name": "CSS Override",
    "description": "Customize CSS for certain sites",
    "version": "1.0.1",
    "browser_specific_settings": {
        "gecko": {
            "id": "css-override@tiagovignatti",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["https://*.globo.com/*"],
            "css": ["content_script.css"],
            "js": ["content_script.js"],
            "run_at": "document_end"
        }
    ]
}